# ---- Public (safe in browser) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=generate with: npm run vapid

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VAPID_PRIVATE_KEY=generate with: npm run vapid
# mailto: or https: URL identifying the sender to push services
VAPID_SUBJECT=mailto:events@example.com
# Random 32+ char secret. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=0
